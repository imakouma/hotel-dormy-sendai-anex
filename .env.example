# Server-only credentials; copy to .env.local.
GEMINI_API_KEY=

# Free-tier billing must also be selected in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave empty until a free-only OmniRoute gateway is configured.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Server-only Groq Free Plan fallback, used when OmniRoute is unavailable.
GROQ_API_KEY=
